# /etc/systemd/system/samantha-tts.service
#
# Run with:
#   sudo cp samantha-tts.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now samantha-tts.service
#
# Logs:
#   journalctl -u samantha-tts.service -f
#
# Edit `User=` if you don't run under "samantha" (e.g. your own
# username). Edit `WorkingDirectory=` if you cloned elsewhere.

[Unit]
Description=Samantha TTS server (Qwen3-TTS, GPU-backed)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=samantha
Group=samantha
WorkingDirectory=/home/samantha/os1-samantha/tts-server

# Bind to all interfaces on port 9876. Restrict with `ufw` instead of
# binding to a single address — that keeps the service reachable from
# the mini-PC at 192.168.100.58 itself and from other LAN devices if
# you ever need to debug from a laptop.
Environment="TTS_HOST=0.0.0.0"
Environment="TTS_PORT=9876"
Environment="TTS_MODEL_PATH=/home/samantha/.samantha/qwen3-tts/1.7B-CustomVoice"
Environment="TTS_DEFAULT_SPEAKER=serena"
Environment="TTS_DEFAULT_LANGUAGE=spanish"
# Uncomment to bake in a style ("Soft, warm voice.", "Whispering.")
# Environment="TTS_DEFAULT_INSTRUCT=Soft, warm voice."

# Make sure CUDA libs from /usr/local/cuda are on the path even when
# systemd starts the unit before any login session sets them up.
Environment="LD_LIBRARY_PATH=/usr/local/cuda/lib64"
Environment="PYTHONUNBUFFERED=1"

ExecStart=/home/samantha/os1-samantha/tts-server/.venv/bin/python server.py

# Auto-restart on crash, with a small back-off so we don't loop hot.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10

# Sandboxing — keeps the unit from writing places it shouldn't.
# Voice models live under the user's home so we expose only that.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/samantha/.samantha
PrivateTmp=true
NoNewPrivileges=true

# GPU access — needs /dev/nvidia* visible. PrivateDevices=true would
# break this; leaving it default.

[Install]
WantedBy=multi-user.target

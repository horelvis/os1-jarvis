[Unit]
Description=Samantha (desktop strip, GTK4)
# The strip is furniture in a graphical session, not a boot service:
# without a display server it exits immediately and systemd restarts it
# forever. PartOf ties it to the session's lifetime.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# X11 only (§2.2). DISPLAY and XAUTHORITY are deliberately NOT set here:
# GNOME imports them into the systemd user manager when the session
# starts (`systemctl --user show-environment`), and `After=`/`PartOf=
# graphical-session.target` above guarantee this unit starts after that.
# Inheriting is also the only version that survives the session number
# changing.
#
# This line used to read `Environment=DISPLAY=:1`, and it was simply
# wrong: this box's session is `:0`. The unit could never start — it
# died in `Gtk couldn't be initialized` before any of our code ran, and
# the strip was absent with the rest of the stack perfectly healthy.
# Found 2026-08-30. `samantha-ui.service`, the dead kiosk unit, had `:0`
# all along.
# Unbuffered, so `journalctl --user -u jarvis-widget -f` shows a
# traceback at the moment it happens rather than at exit.
Environment=PYTHONUNBUFFERED=1
# The venv is --system-site-packages (it needs the system's PyGObject),
# and that also exposes ~/.local/lib, where a different numpy / anyio /
# websockets may live. Mixing the two crashes the process inside an
# unrelated import with no traceback. Everything this widget needs is
# installed IN the venv (pip install --ignore-installed), so the user
# site directory is simply switched off.
Environment=PYTHONNOUSERSITE=1

# NO voice prompt here, and it cost a measurement to learn why.
#
# §2.6 describes `JARVIS_TTS_COSYVOICE_VOICE_PROMPT` as conditioning
# delivery, and the server does prepend it before <|endofprompt|>. But
# the call is `inference_zero_shot`, where `prompt_text` must be the
# TRANSCRIPT OF THE REFERENCE CLIP — that pairing is what the voice is
# cloned from. Text prepended to it no longer describes the audio, the
# clone drifts, and CosyVoice says so on every line:
#
#   synthesis text "aquí estaré." too short than prompt text
#   "Español con acento andaluz, cercano y relajado.<|endofprompt|>…"
#
# Set for an Andalusian accent on 2026-08-26 and removed the same
# evening: the accent did not change (that comes from the clip) and the
# user reported the voice had turned female. Conditioning delivery needs
# `inference_instruct2`, which takes the instruction and the reference
# wav as separate arguments — the server already exposes it; the client
# does not use it.
# Hermes' markers.py and tts.py, the same way Hermes/run-gateway.sh
# reaches them. Without this she runs and is mute: speech.py falls back
# to a local copy of has_unclosed_tag, so the only symptom is silence.
Environment=PYTHONPATH=%h/git/os1-samantha
ExecStart=%h/git/os1-samantha/widget/.venv/bin/python -m jarvis_widget
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target

# Samantha LLM runtime — llama-server (llama.cpp)
#
# Install (production):
#   1. Build/install llama.cpp so `llama-server` is in PATH.
#      The model auto-downloads on first launch via the `-hf` flag below
#      (cached under ~/.cache/llama.cpp/).
#   2. Copy this file to ~/.config/systemd/user/, then:
#        systemctl --user daemon-reload
#        systemctl --user enable --now samantha-llamacpp.service
#
# Override defaults without editing this file:
#   systemctl --user edit samantha-llamacpp.service
# and set Environment= lines in the override.
#
# Sampling defaults are Qwen3-recommended (temp 0.6, top-k 20, top-p 0.95,
# min-p 0, presence-penalty 1.5). Backend (Samantha) never overrides them,
# so this file is the single source of truth for model behavior.

[Unit]
Description=Samantha LLM runtime (llama-server, llama.cpp)
After=network.target
# No rate limit on restarts. The default (5 starts in 10 s) is a loop
# guard written for services that fail instantly and forever; this one
# fails for a while and then succeeds — a cold boot can reach it before
# the NVIDIA driver is ready, and four retries at RestartSec=5 spend the
# whole allowance in 20 s. Measured 2026-08-25: it gave up after four
# attempts and stayed dead, so the gateway came up with no model behind
# it and he answered nothing until somebody restarted it by hand.
StartLimitIntervalSec=0

[Service]
Type=simple

# Model source: HuggingFace repo + quant tag. llama-server auto-downloads
# on first run and caches under ~/.cache/llama.cpp/.
# The model file, not a -hf spec: it is already on disk and pulling it
# again on every install is 13 GB nobody needs.
Environment=SAMANTHA_LLAMA_MODEL=%h/.samantha/models/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q3_K_XL.gguf

# Server bind. Default localhost; override to 0.0.0.0 if the backend
# runs on a different host on the LAN.
Environment=SAMANTHA_LLAMA_HOST=127.0.0.1
Environment=SAMANTHA_LLAMA_PORT=8000

# Offload as many transformer layers to GPU as fit. 99 = "all of them";
# llama.cpp clamps automatically if the model has fewer.
Environment=SAMANTHA_LLAMA_NGL=99

# Context window. Qwen3 supports up to 40K natively; generous headroom
# for Phase 6 memory injection.
# 64K is a HARD FLOOR, not a preference: Hermes refuses any model whose
# context window is under 64,000 and the turn dies with
# "below the minimum 64,000 required by Hermes Agent".
Environment=SAMANTHA_LLAMA_CTX=65536

# The build in ~/git/llama.cpp, not whatever llama-server is on PATH.
# Qwen3.8's hybrid Gated DeltaNet needs a recent build: b9115 failed to
# load the Q3_K_XL outright ("missing tensor blk.64.ssm_conv1d.weight")
# where b10603 loads it and runs it FOUR TIMES faster — 57 tok/s against
# 13.7 for the Q4_K_M on the old build.
ExecStart=%h/git/llama.cpp/build/bin/llama-server \
    -m ${SAMANTHA_LLAMA_MODEL} \
    --host ${SAMANTHA_LLAMA_HOST} \
    --port ${SAMANTHA_LLAMA_PORT} \
    --n-gpu-layers ${SAMANTHA_LLAMA_NGL} \
    --cache-type-k q8_0 \
    --cache-type-v q8_0 \
    --ctx-size ${SAMANTHA_LLAMA_CTX} \
    --jinja \
    --flash-attn on \
# NOT --split-mode row: it splits tensors across several GPUs and this
# box has one. It used to be a harmless no-op; on b10603 it is fatal —
# "device CUDA0 does not support split buffers" — and the model never
# loads, so the gateway answers nothing (measured 2026-08-25).
    --temp 0.6 \
    --top-k 20 \
    --top-p 0.95 \
    --min-p 0 \
    --presence-penalty 1.5 \
    --no-context-shift \
    --metrics

Restart=on-failure
RestartSec=5
# Give the model time to mmap at startup before the watchdog complains.
TimeoutStartSec=120

# Resource hygiene — don't let a runaway llama eat the whole machine.
LimitNOFILE=65536

[Install]
WantedBy=default.target

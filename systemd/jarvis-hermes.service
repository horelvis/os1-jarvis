# JARVIS agentic brain — hermes gateway daemon
#
# Install:
#   1. Install the pinned runtime into the repo: Hermes/setup-runtime.sh
#      (clones hermes-agent at the commit this project is written against,
#      builds its venv, links the plugins and enables them). Do NOT
#      `uv tool install hermes-agent` — PyPI is stale, and a mismatched
#      version fails the plugin contracts silently.
#   2. Copy this file to ~/.config/systemd/user/, then:
#        systemctl --user daemon-reload
#        systemctl --user enable --now jarvis-hermes.service
#
# Override defaults without editing this file:
#   systemctl --user edit jarvis-hermes.service
# and set Environment= lines in the override.

[Unit]
Description=JARVIS agentic brain (Hermes gateway daemon)
After=network.target

[Service]
Type=simple

# systemd starts the process in %h. Originally needed because
# samantha-kiosk's default static root was the RELATIVE path
# "frontend/dist" — which then resolved to ~/frontend/dist and the
# gateway refused to start with "no frontend at
# /home/<user>/frontend/dist". jarvis (the renamed plugin) serves no
# static root at all any more — the widget replaced the frontend it used
# to serve (CLAUDE.md §12, 2026-08-22) — but the working directory stays,
# rather than risk another plugin's relative default breaking the
# same way.
WorkingDirectory=%h/git/os1-samantha

# API Server configuration. Environment variables override the config.yaml and
# .env inside the repo's own HERMES_HOME (.hermes/home/), which run-gateway.sh
# sets — never the machine owner's ~/.hermes.
Environment=API_SERVER_ENABLED=true
Environment=API_SERVER_PORT=8642
Environment=API_SERVER_HOST=127.0.0.1
# API_SERVER_KEY intentionally NOT set here — the unit is committed to
# git. Set the real key in a local drop-in on the kiosk box:
#   systemctl --user edit jarvis-hermes
#   [Service]
#   Environment=API_SERVER_KEY=<new key>

# run-gateway.sh, not a bare `hermes`: /usr/bin/env would pick up whatever
# hermes is on PATH — on a machine with a personal install, that is a
# different version with a different HERMES_HOME. The wrapper pins both, and
# exports the PYTHONPATH the plugins need to import `samantha`.
ExecStart=%h/git/os1-samantha/Hermes/run-gateway.sh

Restart=on-failure
RestartSec=5

# Resource hygiene
LimitNOFILE=65536

[Install]
WantedBy=default.target

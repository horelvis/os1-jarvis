# JARVIS LLM runtime — llama-server (llama.cpp)
#
# Install (production):
#   1. Build/install llama.cpp so `llama-server` is in PATH.
#      The model auto-downloads on first launch via the `-hf` flag below
#      (cached under ~/.cache/llama.cpp/).
#   2. Copy this file to ~/.config/systemd/user/, then:
#        systemctl --user daemon-reload
#        systemctl --user enable --now jarvis-llamacpp.service
#
# Override defaults without editing this file:
#   systemctl --user edit jarvis-llamacpp.service
# and set Environment= lines in the override.
#
# **A model override must budget for WHISPER, and one did not.** The
# widget loads faster-whisper onto the same GPU (~2.5 GB) and this unit
# knows nothing about it, so an override that fits its own arithmetic can
# still leave no room for his ears. That happened: a drop-in of
# 2026-08-27 swapped in the Heretic RVN-IQ4_XS build (14.0 GiB against
# UD-Q3_K_XL's 12.2) for better Spanish at 4 bits, and its own comment
# worked out "~22.7 of 24 GiB, margin 1.3" — a margin measured before
# Whisper. The result was `CUDA failed with error out of memory`, caught
# and logged by the widget and visible nowhere else: the strip drew, the
# wave animated, the gateway connected, and he could not hear a word.
#
# It went unnoticed for three days because a SECOND bug hid it — the
# widget unit named `DISPLAY=:1` on a `:0` box, so the strip never
# started and nobody ever saw Whisper fail. Rolled back 2026-08-30.
#
# The Heretic build is still on disk and the question it was chosen for
# — Spanish at 4 bits — was never actually measured against the cost.
# Worth revisiting deliberately; the budget is the whole constraint
# (CLAUDE.md §2.1), and CosyVoice (~4.9 GB) and Whisper (~2.5 GB) come
# out of it before the model gets a byte.
#
# Sampling defaults are Qwen3-recommended (temp 0.6, top-k 20, top-p 0.95,
# min-p 0, presence-penalty 1.5). Backend (JARVIS) never overrides them,
# so this file is the single source of truth for model behavior.

[Unit]
Description=JARVIS LLM runtime (llama-server, llama.cpp)
After=network.target
# No rate limit on restarts. The default (5 starts in 10 s) is a loop
# guard written for services that fail instantly and forever; this one
# fails for a while and then succeeds — a cold boot can reach it before
# the NVIDIA driver is ready, and four retries at RestartSec=5 spend the
# whole allowance in 20 s. Measured 2026-08-25: it gave up after four
# attempts and stayed dead, so the gateway came up with no model behind
# it and he answered nothing until somebody restarted it by hand.
StartLimitIntervalSec=0

[Service]
Type=simple

# Model source: HuggingFace repo + quant tag. llama-server auto-downloads
# on first run and caches under ~/.cache/llama.cpp/.
# The model file, not a -hf spec: it is already on disk and pulling it
# again on every install is 13 GB nobody needs.
# Source: https://huggingface.co/0bserverx/Qwen3.8-27B-Heretic-Abliterated-Uncensored-GGUF
# (the repo also carries RVN-Q2_K 10 GB, IQ3_S 12 GB, IQ4_XS 14 GB — the
# one used here — and Q6_K 21 GB, which does not fit on this box. The
# "-multilingual" and "-mtp" suffixes are separate variants of each.)
#
# The Heretic build — Qwen3.8-27B with the refusal behaviour removed
# (user's decision, 2026-09-01: "quiero un modelo sin arnés"). Measured
# against the UD-Q3_K_XL it replaces, over nine legitimate home-assistant
# requests a guardrailed model tends to decline:
#
#   both answer          blunt criticism of the user's network · how to
#                        audit his own cameras · ibuprofen dosing · Spanish
#                        law on a neighbour's camera · demolishing his
#                        business plan · swearing on request
#   only the Heretic     dark humour · stating a political opinion of its
#                        own · holding a rude character without softening
#
# It costs 17,354 MiB against 15,296, and 46 tok/s against 52.5 — the
# larger file is ~12% slower even wholly on the GPU.
#
# IT ONLY FITS BECAUSE OF TWO OTHER CHANGES made the same day, and if
# either is reverted this model stops loading:
#   · Whisper moved to int8 (stt.py), giving back 992 MiB
#   · the KV cache below, q8_0 → q4_0, giving back ~450 MiB
#
# The budget, measured 2026-09-01 with everything resident:
#   llama-server 17,354 + CosyVoice 5,080 + widget 1,529 + the DESKTOP 162
#   (Xorg 99, gnome-shell 28, a browser tab 35 — §2.5's arithmetic never
#   counted it) = 24,125 of 24,564.
Environment=JARVIS_LLAMA_MODEL=%h/.jarvis/models/Qwen3.8-27B-Heretic-GGUF/RVN-IQ4_XS-multilingual.gguf

# Server bind. Default localhost; override to 0.0.0.0 if the backend
# runs on a different host on the LAN.
Environment=JARVIS_LLAMA_HOST=127.0.0.1
Environment=JARVIS_LLAMA_PORT=8000

# Offload as many transformer layers to GPU as fit. 99 = "all of them";
# llama.cpp clamps automatically if the model has fewer.
Environment=JARVIS_LLAMA_NGL=99

# Context window. Qwen3 supports up to 40K natively; generous headroom
# for Phase 6 memory injection.
# 64K is a HARD FLOOR, not a preference: Hermes refuses any model whose
# context window is under 64,000 and the turn dies with
# "below the minimum 64,000 required by Hermes Agent".
Environment=JARVIS_LLAMA_CTX=65536

# The build in ~/git/llama.cpp, not whatever llama-server is on PATH.
# Qwen3.8's hybrid Gated DeltaNet needs a recent build: b9115 failed to
# load the Q3_K_XL outright ("missing tensor blk.64.ssm_conv1d.weight")
# where b10603 loads it and runs it FOUR TIMES faster — 57 tok/s against
# 13.7 for the Q4_K_M on the old build.
ExecStart=%h/git/llama.cpp/build/bin/llama-server \
    -m ${JARVIS_LLAMA_MODEL} \
    --host ${JARVIS_LLAMA_HOST} \
    --port ${JARVIS_LLAMA_PORT} \
    --n-gpu-layers ${JARVIS_LLAMA_NGL} \
    --cache-type-k q4_0 \
    --cache-type-v q4_0 \
    --ctx-size ${JARVIS_LLAMA_CTX} \
    --jinja \
    --flash-attn on \
# NOT --split-mode row: it splits tensors across several GPUs and this
# box has one. It used to be a harmless no-op; on b10603 it is fatal —
# "device CUDA0 does not support split buffers" — and the model never
# loads, so the gateway answers nothing (measured 2026-08-25).
    --temp 0.6 \
    --top-k 20 \
    --top-p 0.95 \
    --min-p 0 \
    --presence-penalty 1.5 \
    --no-context-shift \
# A ceiling on ONE generation, and the reason it exists is thermal.
# Measured 2026-08-26: a single request reached 15,099 tokens and was
# still going, at 50 tok/s, with the kiosk's 90 s watchdog having closed
# that turn minutes earlier — nobody was waiting for those tokens and
# the GPU sat at 93% and 391 W producing them. The same shape is in
# yesterday's journal (12,576), which means the GPU load blamed on the
# camera alerts on 2026-08-25, and answered by switching gateway
# injection off, was at least partly THIS.
#
# 2048 is ~40 s of generation and far beyond any spoken reply (a long
# one is under 200). It bounds the damage; it does not fix a model that
# loops, which is a Hermes-side iteration limit and is not configured
# here.
    --n-predict 2048 \
    --metrics

Restart=on-failure
RestartSec=5
# Give the model time to mmap at startup before the watchdog complains.
TimeoutStartSec=120

# Resource hygiene — don't let a runaway llama eat the whole machine.
LimitNOFILE=65536

[Install]
WantedBy=default.target

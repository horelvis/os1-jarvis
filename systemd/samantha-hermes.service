# Samantha agentic brain — hermes gateway daemon
#
# Install:
#   1. Install hermes-agent inside Samantha's workspace or system-wide using uv:
#      uv tool install hermes-agent --with mcp
#   2. Copy this file to ~/.config/systemd/user/, then:
#        systemctl --user daemon-reload
#        systemctl --user enable --now samantha-hermes.service
#
# Override defaults without editing this file:
#   systemctl --user edit samantha-hermes.service
# and set Environment= lines in the override.

[Unit]
Description=Samantha agentic brain (Hermes gateway daemon)
After=network.target

[Service]
Type=simple

# API Server configuration. Environment variables override config.yaml / ~/.hermes/.env.
Environment=API_SERVER_ENABLED=true
Environment=API_SERVER_PORT=8642
Environment=API_SERVER_HOST=127.0.0.1
# API_SERVER_KEY intentionally NOT set here — the unit is committed to
# git. Set the real key in a local drop-in on the kiosk box:
#   systemctl --user edit samantha-hermes
#   [Service]
#   Environment=API_SERVER_KEY=<new key>

# Path to the hermes executable (adjust if installed in a virtualenv or custom location)
ExecStart=/usr/bin/env hermes gateway

Restart=on-failure
RestartSec=5

# Resource hygiene
LimitNOFILE=65536

[Install]
WantedBy=default.target

# Samantha FastAPI backend (serves UI + API on :7777).
#
# Install:
#   1. Build the frontend once: cd frontend && pnpm install && pnpm build
#   2. Copy this file to ~/.config/systemd/user/, then:
#        systemctl --user daemon-reload
#        systemctl --user enable --now samantha-backend.service
#
# Override defaults without editing this file (e.g. to inject the
# Grok API key or point at a different LLM server URL):
#   systemctl --user edit samantha-backend
# and add Environment= lines in the [Service] override section.

[Unit]
Description=Samantha backend (FastAPI on :7777)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=SAMANTHA_MODE=real
WorkingDirectory=%h/git/os1-samantha/backend
ExecStart=%h/git/os1-samantha/backend/.venv/bin/python -m samantha.api
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

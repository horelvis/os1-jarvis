[Unit]
Description=Samantha code bridge (A2A) — the coding assistant, callable
# Not PartOf=graphical-session: this has nothing to do with the strip and
# should be reachable whether or not anybody has logged in.
After=network.target

[Service]
Type=simple
# The gate: Bash commands matching any of these ask the user first.
# Set, the variable IS the whole policy — add "git commit" here to gate
# commits too. Default in code: git push, rm -r, rm -f, sudo.
#Environment=JARVIS_CODE_GATES=git push, rm -r, rm -f, sudo
# Its own venv since 2026-08-26: the bridge needs `claude-agent-sdk`
# (~386 MB with the CLI it bundles) to stop a run and to continue a
# conversation. It is kept out of the widget's environment on purpose —
# that one holds Whisper on the GPU and is not worth disturbing for a
# dependency only this process imports.
#   python3 -m venv .venv && .venv/bin/pip install claude-agent-sdk
# Without it the bridge still works: it falls back to driving the CLI,
# and loses exactly those two abilities.
ExecStart=%h/git/os1-samantha/Hermes/bridges/code-a2a/.venv/bin/python %h/git/os1-samantha/Hermes/bridges/code-a2a/server.py --port 9910 --root %h/git
WorkingDirectory=%h/git/os1-samantha/Hermes/bridges/code-a2a
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1

# The assistant it drives needs the user's own credentials and config —
# it is the user's assistant, run as the user. That is the whole design
# and also why the port is bound to localhost by default.
Environment=HOME=%h

Restart=on-failure
RestartSec=5
# It spawns a coding assistant that can take minutes; do not kill the
# tree on a slow stop.
TimeoutStopSec=60

[Install]
WantedBy=default.target

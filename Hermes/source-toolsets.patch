             override = None

-        if override and isinstance(override, list):
+        if isinstance(override, list):
+            if not override:
+                return []
+            from hermes_cli.tools_config import enabled_mcp_server_names
+            from toolsets import validate_toolset
+
             cfg = dict(user_config)
             pts = dict(cfg.get("platform_toolsets") or {})
             pts[platform_key] = [str(t) for t in override]
             cfg["platform_toolsets"] = pts
-            return sorted(_get_platform_tools(cfg, platform_key))
+            allowed = set(pts[platform_key])
+            # Platform config preserves passthrough names, including unknowns.
+            known_mcp = enabled_mcp_server_names(cfg)
+            return sorted(
+                name
+                for name in _get_platform_tools(cfg, platform_key) & allowed
+                if validate_toolset(name) or name in known_mcp
+            )

         return sorted(_get_platform_tools(user_config, platform_key))


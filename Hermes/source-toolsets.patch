+    @pytest.mark.parametrize("override", [[], ["web"], None])
+    def test_override_bounds_automatic_capabilities(self, monkeypatch, override):
+        from hermes_cli import tools_config
+
+        monkeypatch.setattr(
+            tools_config, "_get_plugin_toolset_keys", lambda: {"unrelated_plugin"}
+        )
+        cfg = {
+            "platform_toolsets": {"webhook": ["terminal", "file"]},
+            "mcp_servers": {"unrelated_mcp": {"command": "never-executed"}},
+        }
+        defaults = _get_platform_tools(cfg, "webhook")
+        assert {"terminal", "file", "unrelated_plugin", "unrelated_mcp"} <= defaults
+        gr = _make_runner(SimpleNamespace(toolsets_for_source=lambda source: override))
+        result = gr._resolve_enabled_toolsets_for_source(cfg, _Src("test"), "webhook")
+        assert result == (sorted(defaults) if override is None else override)
+
+    @pytest.mark.parametrize("retained", [[], ["web"]])
+    def test_unknown_disabled_and_restricted_overrides_are_dropped(self, retained):
+        override = retained + ["terminal", "discord_admin", "unknown_toolset"]
+        wa = _make_adapter({"mon": {"toolsets": override}})
+        cfg = {"agent": {"disabled_toolsets": ["terminal"]}}
+        result = _make_runner(wa)._resolve_enabled_toolsets_for_source(
+            cfg, _Src("webhook:mon:d"), "webhook"
+        )
+        assert result == retained
+
+    def test_explicit_mcp_survives_without_registry_discovery(self):
+        cfg = {"mcp_servers": {"selected_mcp": {"command": "never-executed"}}}
+        wa = _make_adapter({"mon": {"toolsets": ["web", "selected_mcp"]}})
+        result = _make_runner(wa)._resolve_enabled_toolsets_for_source(
+            cfg, _Src("webhook:mon:d"), "webhook"
+        )
+        assert result == ["selected_mcp", "web"]
